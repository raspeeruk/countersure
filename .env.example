# HMRC Check a UK VAT number API v2.
# Use the production application credentials from the HMRC Developer Hub.
# Sandbox credentials only resolve mock traders (for example 553557881) and
# make real numbers such as GB220430231 look unregistered.
HMRC_CLIENT_ID=
HMRC_CLIENT_SECRET=
# Optional static server token. Used instead of the client id and secret when set.
# HMRC_SERVER_TOKEN=
# Optional. Defaults to https://api.service.hmrc.gov.uk.
# A sandbox host here is ignored on the production site.
HMRC_API_BASE=https://api.service.hmrc.gov.uk
# Local sandbox only. Do not set these on the production site.
# HMRC_USE_SANDBOX=true
# HMRC_API_BASE_SANDBOX=https://test-api.service.hmrc.gov.uk

# Resend (for contact form + magic links)
RESEND_API_KEY=
CONTACT_TO_EMAIL=andrew@twocores.com

# Auth
AUTH_SECRET=
AUTH_URL=https://countersure.com
AUTH_RESEND_KEY=
AUTH_TRUST_HOST=true

# Database (auto-created by Netlify Neon extension)
NETLIFY_DATABASE_URL=
NETLIFY_DATABASE_URL_UNPOOLED=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Analytics
NEXT_PUBLIC_GA_ID=
